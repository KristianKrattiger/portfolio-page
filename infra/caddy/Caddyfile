# /srv/hosted-layer/caddy/Caddyfile
#
# Domain-agnostic origin config behind Cloudflare Tunnel.
# Edge TLS terminates at Cloudflare; traffic between cloudflared and caddy
# never leaves the internal Docker bridge network (edge-net).

{
	auto_https off
	admin off
	servers {
		# Trust X-Forwarded-* headers only from private Docker bridge subnets.
		trusted_proxies static private_ranges
	}
}

# Optional canonical www -> apex redirect once you choose a domain:
# http://www.yourdomain.com {
# 	redir https://yourdomain.com{uri} permanent
# }

:80 {
	encode zstd gzip

	# Health check endpoint (loopback & Uptime Kuma / external probes)
	handle /healthz {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "no-store"
		respond "ok" 200
	}

	# Security headers mirroring portfolio/render.py + HTTP-only protections.
	# Cloudflare HTML rewriting (RUM, Email Obfuscation, Rocket Loader, Speed Brain)
	# MUST be disabled in the Cloudflare dashboard so these headers hold byte-for-byte.
	header {
		Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; script-src 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Cache policy
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	@css path /style.css
	header @css Cache-Control "public, max-age=3600, must-revalidate"

	@docs {
		not path /fonts/* /style.css /healthz
	}
	header @docs Cache-Control "public, max-age=300, stale-while-revalidate=60"

	root * /srv/portfolio/current
	file_server

	handle_errors {
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_code} {err.status_text}"
	}
}

# Future expansion example (add service to edge-net + hostname in Cloudflare Tunnel):
# http://sear.yourdomain.com {
# 	reverse_proxy sear-demo:8000
# }
