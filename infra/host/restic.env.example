# Install path: /etc/hosted-layer/restic.env
# Lock permissions:
#   sudo chown root:root /etc/hosted-layer/restic.env
#   sudo chmod 600 /etc/hosted-layer/restic.env

# Example Cloudflare R2 S3-compatible bucket (10 GB free tier):
export RESTIC_REPOSITORY="s3:https://<account-id>.r2.cloudflarestorage.com/<bucket-name>/beelink-hosted-layer"
export RESTIC_PASSWORD="generate-a-long-random-passphrase-and-store-in-password-manager"
export AWS_ACCESS_KEY_ID="r2-access-key-id"
export AWS_SECRET_ACCESS_KEY="r2-secret-access-key"

# Optional external Healthchecks.io ping URLs:
export HEALTHCHECKS_BACKUP_URL=""
export HEALTHCHECKS_HEARTBEAT_URL=""
export HEALTHCHECKS_STALE_URL=""
