# Copy to /srv/hosted-layer/.env on the Beelink SER and lock permissions:
#   sudo chown root:root /srv/hosted-layer/.env
#   sudo chmod 600 /srv/hosted-layer/.env

# Remotely managed Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Optional: set once you pick a domain (used by helper checks/docs; Caddy serves :80 either way)
PORTFOLIO_DOMAIN=
